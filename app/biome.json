{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": ".."
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always",
			"bracketSpacing": true
		}
	},
	"linter": {
		"rules": {
			"preset": "none",
			"correctness": {
				"noUnusedVariables": "warn"
			},
			"style": {
				"useConsistentArrayType": {
					"level": "error",
					"options": {
						"syntax": "shorthand"
					}
				},
				"useConsistentObjectDefinitions": {
					"level": "error",
					"options": {
						"syntax": "shorthand"
					}
				}
			},
			"suspicious": {
				"noDoubleEquals": {
					"level": "error",
					"options": {
						"ignoreNull": true
					}
				},
				"noEmptyBlockStatements": "error"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}
